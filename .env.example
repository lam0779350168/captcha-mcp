# Provider: twocaptcha | capsolver | capmonster | nopecha
CAPTCHA_PROVIDER=twocaptcha
CAPTCHA_TWOCAPTCHA_KEY=your_2captcha_key
# CAPTCHA_CAPSOLVER_KEY=
# CAPTCHA_CAPMONSTER_KEY=
# CAPTCHA_NOPECHA_KEY=

CAPTCHA_DEFAULT_TIMEOUT=60
CAPTCHA_POLL_INTERVAL=2.0
# CAPTCHA_PROXY_URL=http://user:pass@host:port

# ── stealth / detection layer ──────────────────────────────
CAPTCHA_STEALTH_BACKEND=nodriver        # nodriver | cloakbrowser
CAPTCHA_STEALTH_HEADLESS=true
CAPTCHA_TLS_IMPERSONATE=chrome          # chrome | chrome124 | firefox | safari | edge
CAPTCHA_HTTP_TIMEOUT=30
