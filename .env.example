# ── solver (100% local, không gọi dịch vụ ngoài) ────────────
CAPTCHA_WIDGET_TIMEOUT=30
CAPTCHA_PAGE_WAIT=2.0
CAPTCHA_OCR_BACKEND=auto          # auto | tesseract | ddddocr
CAPTCHA_OCR_PSM=7
CAPTCHA_OCR_MIN_CONFIDENCE=60

# ── stealth ─────────────────────────────────────────────────
CAPTCHA_STEALTH_BACKEND=nodriver  # nodriver | cloakbrowser
CAPTCHA_STEALTH_HEADLESS=true
CAPTCHA_TLS_IMPERSONATE=chrome    # chrome | chrome124 | firefox | safari | edge
CAPTCHA_HTTP_TIMEOUT=30

# proxy mặc định (Turnstile hay ràng buộc IP)
# CAPTCHA_PROXY_URL=http://user:pass@host:port
